# =============================================================================
# Notebook – Beispielkonfiguration
#
# Diese Datei ist eine Vorlage und enthält KEINE echten Keys.
# Kopieren nach .env.local – diese Datei ist in .gitignore und wird nie
# committet:
#
#   cp .env.example .env.local
#
# Für Vercel: dieselben Variablen unter Project → Settings → Environment
# Variables eintragen (Production, Preview, Development).
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres mit pgvector  (Pflicht)
# -----------------------------------------------------------------------------
# Format: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
#
# Lokal mit Docker:
#   docker run --name notebook-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=notebook -p 5433:5432 -d pgvector/pgvector:pg16
#   → postgres://postgres:postgres@localhost:5433/notebook
#
# Supabase:  Project → Settings → Database → Connection string → "URI"
#            Für serverless den Pooler-Port 6543 nehmen, nicht 5432.
# Neon:      Project → Dashboard → Connection string; der "-pooler" Host.
#            Beide bringen pgvector mit, `CREATE EXTENSION vector` genügt.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/notebook

# -----------------------------------------------------------------------------
# LLM- und Embedding-Provider  (Pflicht ab Schritt 2)
# -----------------------------------------------------------------------------
# Ein Key für beides: Embeddings (text-embedding-3-small) und den Chat
# (Default gpt-4o-mini). Der Build läuft auch ohne diesen Key durch; er wird
# erst beim ersten echten Aufruf gelesen.
#
# WICHTIG: Auf dem Key ein monatliches Ausgabenlimit setzen
# (platform.openai.com → Settings → Limits). Ein Testlauf mit großen PDFs
# kann sonst teuer werden.
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Chat-Modell  (optional)
# -----------------------------------------------------------------------------
# Überschreibt den Default gpt-4o-mini. Andere sinnvolle Werte: gpt-4o,
# gpt-4.1-mini. Das Embedding-Modell ist absichtlich NICHT konfigurierbar:
# seine Dimension (1536) steht fest in db/schema.sql, ein Wechsel wäre eine
# Migration plus Re-Embedding aller Dokumente.
# CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Basis-URL  (optional)
# -----------------------------------------------------------------------------
# Nur für absolute Links (z. B. PDF-Viewer im Beleg-Link). Lokal nicht nötig.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
